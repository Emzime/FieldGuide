# Line endings: LF everywhere (repository and checkout, Windows included).
# WoW reads LF files fine; this avoids CRLF conversion warnings in Git clients.
* text=auto eol=lf

# Addon sources (UTF-8 text)
*.lua  text eol=lf
*.toc  text eol=lf
*.xml  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf

# Binary assets
*.tga  binary
*.blp  binary
*.png  binary
*.jpg  binary
*.ogg  binary
*.mp3  binary
*.ttf  binary
*.zip  binary

# Kept out of "Download ZIP" / git archive
.github/        export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
